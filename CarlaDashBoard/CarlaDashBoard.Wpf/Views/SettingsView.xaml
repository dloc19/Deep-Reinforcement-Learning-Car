<UserControl x:Class="CarlaDashBoard.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CarlaDashBoard.Wpf.ViewModels"
             xmlns:models="clr-namespace:CarlaDashBoard.Wpf.Models"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <ScrollViewer Padding="20" Background="{StaticResource BgBrush}">
        <StackPanel MaxWidth="900">

            <!-- ===== Kết nối Bridge Server ===== -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Kết nối Bridge Server" Style="{StaticResource HeadingText}"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,10,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Kết nối" Command="{Binding ConnectCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                        <Button Content="Ngắt kết nối" Command="{Binding DisconnectCommand}" Margin="0,0,16,0"/>
                        <Ellipse Width="10" Height="10" Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ConnectionState, Converter={StaticResource ConnStateToText}}" VerticalAlignment="Center" Style="{StaticResource SoftText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="▶ Bắt đầu phiên" Command="{Binding StartSessionCommand}" Margin="0,0,8,0"/>
                        <Button Content="■ Dừng phiên" Command="{Binding StopSessionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Bản đồ & thời tiết ===== -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Bản đồ &amp; thời tiết" Style="{StaticResource HeadingText}"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,10,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Town" Style="{StaticResource SoftText}" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Towns}" SelectedItem="{Binding SelectedTown}" Width="150" Margin="0,0,8,0"/>
                                <Button Content="Áp dụng" Command="{Binding ApplyTownCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Thời tiết" Style="{StaticResource SoftText}" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding WeatherPresets}" SelectedItem="{Binding SelectedWeatherPreset}"
                                          DisplayMemberPath="Name" Width="180" Margin="0,0,8,0"/>
                                <Button Content="Áp dụng" Command="{Binding ApplyWeatherCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource SoftText}" FontSize="11">
                        <Run Text="Xe: "/><Run Text="{Binding VehicleFilter, Mode=OneWay}"/>
                        <Run Text="  ·  Spawn points: "/><Run Text="{Binding SpawnPointCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== Chế độ vận hành ===== -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Chế độ vận hành" Style="{StaticResource HeadingText}"/>
                    <TextBlock Text="chỉ một mode chạy tại một thời điểm — đổi mode sẽ dừng phiên hiện tại"
                               Style="{StaticResource SoftText}" FontSize="11" Margin="0,4,0,14"/>

                    <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Tile" BorderThickness="1.5" CornerRadius="6" Margin="4"
                                                    Padding="12" MinHeight="90" Width="210" Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush2}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ModeOption}">
                                <StackPanel Cursor="Hand">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SoftText}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,6,0,8"/>
                                    <TextBlock Text="Phase sau" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                               Visibility="{Binding Implemented, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Đã chọn: " Style="{StaticResource SoftText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedMode.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0"/>
                        <Button Content="Áp dụng mode" Command="{Binding ApplyModeCommand}" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Camera ===== -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Camera" Style="{StaticResource HeadingText}"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,10,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Rộng" Style="{StaticResource SoftText}" FontSize="11"/>
                            <TextBox Text="{Binding CameraWidth}" Width="70"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Cao" Style="{StaticResource SoftText}" FontSize="11"/>
                            <TextBox Text="{Binding CameraHeight}" Width="70"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="FOV" Style="{StaticResource SoftText}" FontSize="11"/>
                            <TextBox Text="{Binding CameraFov}" Width="60"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="FPS phát" Style="{StaticResource SoftText}" FontSize="11"/>
                            <TextBox Text="{Binding CameraFps}" Width="60"/>
                        </StackPanel>
                        <Button Content="Áp dụng" Command="{Binding ApplyCameraCommand}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SoftText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
