<UserControl x:Class="CarlaDashBoard.Wpf.Views.LiveDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CarlaDashBoard.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:LiveDriveViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="18" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="248"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <!-- ===== Camera pane ===== -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}"
                Padding="0" Margin="0,0,14,14" ClipToBounds="True">
            <Grid>
                <!-- RGB -->
                <Image Source="{Binding RgbFrame}" Stretch="Uniform"
                       Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Rgb}"/>
                <!-- Segmentation -->
                <Image Source="{Binding SegFrame}" Stretch="Uniform"
                       Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Segmentation}"/>
                <!-- Split -->
                <Grid Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Split}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding RgbFrame}" Stretch="Uniform"/>
                    <Image Grid.Column="1" Source="{Binding SegFrame}" Stretch="Uniform"/>
                    <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                               Fill="{StaticResource BorderBrush2}"/>
                    <!-- Split label -->
                    <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="10" Padding="6,2" CornerRadius="4" Background="#AA161B22">
                        <TextBlock Text="RGB" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkSoftBrush}"/>
                    </Border>
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="10" Padding="6,2" CornerRadius="4" Background="#AA161B22">
                        <TextBlock Text="SEG" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource RouteBrush}"/>
                    </Border>
                </Grid>

                <!-- Placeholder (no frame) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding RgbFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}">
                    <TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{StaticResource InkFaintBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Chưa có khung hình"
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource InkSoftBrush}"/>
                    <TextBlock Text="Vào Settings → kết nối Bridge Server rồi bắt đầu phiên"
                               Style="{StaticResource SoftText}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Camera mode toggle pill (top-right) -->
                <Border Background="{StaticResource SurfaceDeepBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="20" Padding="3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style x:Key="CamPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Padding"          Value="11,4"/>
                                <Setter Property="Margin"           Value="1,0"/>
                                <Setter Property="BorderThickness"  Value="0"/>
                                <Setter Property="Background"       Value="Transparent"/>
                                <Setter Property="FontSize"         Value="12"/>
                                <Setter Property="FontWeight"       Value="Medium"/>
                                <Setter Property="Foreground"       Value="{StaticResource InkSoftBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="#1AF0A030"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="RGB" Command="{Binding ShowRgbCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Rgb}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#100C00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Seg" Command="{Binding ShowSegmentationCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Segmentation}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#100C00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Split" Command="{Binding ShowSplitCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Split}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#100C00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- LIVE badge -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                        CornerRadius="4" Padding="7,3" Background="#CC0D1117"
                        BorderBrush="{StaticResource CritBrush}" BorderThickness="1"
                        Visibility="{Binding RgbFrame, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource CritBrush}"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource CritBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== HUD strip ===== -->
        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}"
                Margin="0,0,14,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Telemetry.SpeedKmh, StringFormat={}{0:0}}"
                               Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="km/h · tốc độ" Style="{StaticResource MetricLabel}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush2}" Opacity="0.6"/>

                <!-- Mode -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding Telemetry.Mode}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource RouteBrush}"/>
                    <TextBlock Text="mode hiện tại" Style="{StaticResource MetricLabel}"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush2}" Opacity="0.6"/>

                <!-- Town -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding Telemetry.Town}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="bản đồ" Style="{StaticResource MetricLabel}"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{StaticResource BorderBrush2}" Opacity="0.6"/>

                <!-- Connection status -->
                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{Binding Telemetry.Connected, Converter={StaticResource BoolToBrush},
                                        ConverterParameter=#3FB950|#F85149}"/>
                        <TextBlock Text="{Binding Telemetry.Connected, Converter={StaticResource BoolToString},
                                          ConverterParameter=đã kết nối|mất kết nối}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding Telemetry.Connected, Converter={StaticResource BoolToBrush},
                                               ConverterParameter=#3FB950|#F85149}"/>
                    </StackPanel>
                    <TextBlock Text="trạng thái kết nối" Style="{StaticResource MetricLabel}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Right panel: session info + recording ===== -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock Text="◈" Style="{StaticResource SectionIcon}" FontSize="14"/>
                    <TextBlock Text="Phiên hiện tại" Style="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Style="{StaticResource SectionDivider}"/>

                <!-- Town & Mode info -->
                <Border CornerRadius="6" Background="{StaticResource SurfaceAltBrush}"
                        Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Telemetry.Town}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Telemetry.Mode}" Style="{StaticResource SoftText}"
                                   FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Data collection section -->
                <StackPanel Visibility="{Binding IsDataCollectionMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⏺" FontSize="12" Foreground="{StaticResource CritBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Ghi dữ liệu" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="{Binding Telemetry.Recording, Converter={StaticResource BoolToString},
                                     ConverterParameter=⏸  Dừng ghi|⏺  Bắt đầu ghi}"
                            Command="{Binding ToggleRecordCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"
                            Padding="12,9"/>

                    <!-- Stats -->
                    <Border CornerRadius="6" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Frames" Style="{StaticResource MetricLabel}"
                                           Width="60" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SoftText}" FontSize="12">
                                    <Run Text="{Binding Telemetry.FramesRecorded, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Telemetry.RecordElapsedS, StringFormat={}{0:0}s, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Events" Style="{StaticResource MetricLabel}"
                                           Width="60" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SoftText}" FontSize="12">
                                    <Run Text="va chạm: "/>
                                    <Run Text="{Binding Telemetry.CollisionCount, Mode=OneWay}"
                                         Foreground="{StaticResource CritBrush}"/>
                                    <Run Text="  lấn làn: "/>
                                    <Run Text="{Binding Telemetry.LaneInvasionCount, Mode=OneWay}"
                                         Foreground="{StaticResource AccentBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SoftText}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
