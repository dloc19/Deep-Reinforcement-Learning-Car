<UserControl x:Class="CarlaDashBoard.Wpf.Views.LiveDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CarlaDashBoard.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:LiveDriveViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="20" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- ===== Camera pane ===== -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,16,16">
            <Grid>
                <!-- RGB -->
                <Image Source="{Binding RgbFrame}" Stretch="Uniform"
                       Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Rgb}"/>
                <!-- Segmentation -->
                <Image Source="{Binding SegFrame}" Stretch="Uniform"
                       Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Segmentation}"/>
                <!-- Split -->
                <Grid Visibility="{Binding DisplayMode, Converter={StaticResource CamModeToVisibility}, ConverterParameter=Split}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding RgbFrame}" Stretch="Uniform"/>
                    <Image Grid.Column="1" Source="{Binding SegFrame}" Stretch="Uniform"/>
                    <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{StaticResource BorderBrush2}"/>
                </Grid>

                <TextBlock Text="Chưa có khung hình — kết nối Bridge Server ở Settings rồi bắt đầu phiên."
                           Style="{StaticResource SoftText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding RgbFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}"
                           TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>

                <!-- RGB / Seg / Split toggle -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="15" Padding="3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style x:Key="CamToggleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="Margin" Value="2,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="RGB" Command="{Binding ShowRgbCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Rgb}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#171200"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Seg" Command="{Binding ShowSegmentationCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Segmentation}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#171200"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Split" Command="{Binding ShowSplitCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CamToggleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static vm:CameraDisplayMode.Split}">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#171200"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== HUD strip ===== -->
        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <UniformGrid Columns="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Telemetry.SpeedKmh, StringFormat={}{0:0} km/h}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="tốc độ" Style="{StaticResource SoftText}" FontSize="11"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Telemetry.Mode}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RouteBrush}"/>
                    <TextBlock Text="mode hiện tại" Style="{StaticResource SoftText}" FontSize="11"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Telemetry.Town}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="bản đồ" Style="{StaticResource SoftText}" FontSize="11"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="8" Height="8" Fill="{Binding Telemetry.Connected, Converter={StaticResource BoolToBrush}, ConverterParameter=#5EC98A|#E2635F}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Telemetry.Connected, Converter={StaticResource BoolToString}, ConverterParameter=đã kết nối|mất kết nối}" Style="{StaticResource SoftText}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ===== Right panel: session info + recording ===== -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Phiên hiện tại" Style="{StaticResource HeadingText}"/>
                <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,10,0,12"/>
                <TextBlock Text="{Binding Telemetry.Town}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Telemetry.Mode}" Style="{StaticResource SoftText}" Margin="0,0,0,16"/>

                <StackPanel Visibility="{Binding IsDataCollectionMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Ghi dữ liệu (Data Collection)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="{Binding Telemetry.Recording, Converter={StaticResource BoolToString}, ConverterParameter=⏸ Dừng ghi|⏺ Bắt đầu ghi}"
                            Command="{Binding ToggleRecordCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource SoftText}" FontSize="11">
                        <Run Text="{Binding Telemetry.FramesRecorded, Mode=OneWay}"/>
                        <Run Text=" frame · "/>
                        <Run Text="{Binding Telemetry.RecordElapsedS, StringFormat={}{0:0}s, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SoftText}" FontSize="11">
                        <Run Text="va chạm: "/><Run Text="{Binding Telemetry.CollisionCount, Mode=OneWay}"/>
                        <Run Text="  ·  lấn làn: "/><Run Text="{Binding Telemetry.LaneInvasionCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SoftText}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
