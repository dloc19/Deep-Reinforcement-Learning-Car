<Window x:Class="CarlaDashBoard.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carla Dashboard" Height="760" Width="1200" MinWidth="900" MinHeight="600"
        Icon="{StaticResource AppIcon}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Nav rail (design doc §06) ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== App mark ===== -->
                <StackPanel Grid.Row="0" Margin="18,20,16,22">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource AppIcon}" Width="26" Height="26" Margin="0,0,10,0"/>
                        <TextBlock Text="CarlaDashBoard" Style="{StaticResource HeadingText}" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Bảng điều khiển CARLA" Style="{StaticResource EyebrowText}" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ===== Nav items ===== -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button x:Name="NavLiveDrive" Command="{Binding ShowLiveDriveCommand}"
                            AutomationProperties.AutomationId="NavLiveDrive">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveDriveActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Drive" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRouteMap" Command="{Binding ShowRouteMapCommand}"
                            AutomationProperties.AutomationId="NavRouteMap">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouteMapActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛯" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Route &amp; Map" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Command="{Binding ShowSettingsCommand}"
                            AutomationProperties.AutomationId="NavSettings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===== Connection status footer ===== -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,0,16,18">
                    <Ellipse Width="9" Height="9" Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToBrush}}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionState, Converter={StaticResource ConnStateToText}}"
                               Style="{StaticResource SoftText}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Active screen ===== -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
