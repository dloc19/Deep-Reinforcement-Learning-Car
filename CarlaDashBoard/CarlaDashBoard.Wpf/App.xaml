<Application x:Class="CarlaDashBoard.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CarlaDashBoard.Wpf.ViewModels"
             xmlns:views="clr-namespace:CarlaDashBoard.Wpf.Views"
             xmlns:conv="clr-namespace:CarlaDashBoard.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Palette — mirrors the "Carla Dashboard" design doc's dark tokens ===== -->
            <SolidColorBrush x:Key="BgBrush" Color="#11151A"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171C22"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C232B"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#2A323B"/>
            <SolidColorBrush x:Key="InkBrush" Color="#E8ECEF"/>
            <SolidColorBrush x:Key="InkSoftBrush" Color="#A6B1B9"/>
            <SolidColorBrush x:Key="InkFaintBrush" Color="#6F7A83"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#E8A33D"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#29E8A33D"/>
            <SolidColorBrush x:Key="RouteBrush" Color="#57C6D2"/>
            <SolidColorBrush x:Key="GoodBrush" Color="#5EC98A"/>
            <SolidColorBrush x:Key="CritBrush" Color="#E2635F"/>

            <!-- ===== App mark — vector so no external .ico asset is needed (Window.Icon
                 accepts any ImageSource, DrawingImage included) ===== -->
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#171C22">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#E8A33D" Thickness="5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="30,34" RadiusX="18" RadiusY="18"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#E8A33D">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="30,34" RadiusX="4" RadiusY="4"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#E8A33D" Thickness="4" StartLineCap="Round" EndLineCap="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="30,34" EndPoint="43,21"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ===== Converters ===== -->
            <conv:ConnectionStateToBrushConverter x:Key="ConnStateToBrush"/>
            <conv:ConnectionStateToTextConverter x:Key="ConnStateToText"/>
            <conv:CameraModeToVisibilityConverter x:Key="CamModeToVisibility"/>
            <conv:BoolToStringConverter x:Key="BoolToString"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:EqualityToBoolConverter x:Key="EqualityToBool"/>
            <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ===== Base styles ===== -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="SoftText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            </Style>

            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#171200"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="10,2"/>
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <!-- ===== View <-> ViewModel templates ===== -->
            <DataTemplate DataType="{x:Type vm:LiveDriveViewModel}">
                <views:LiveDriveView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RouteMapViewModel}">
                <views:RouteMapView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
