<Application x:Class="CarlaDashBoard.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CarlaDashBoard.Wpf.ViewModels"
             xmlns:views="clr-namespace:CarlaDashBoard.Wpf.Views"
             xmlns:conv="clr-namespace:CarlaDashBoard.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Palette — Dark Pro Token System ===== -->
            <SolidColorBrush x:Key="BgBrush"          Color="#0D1117"/>
            <SolidColorBrush x:Key="SurfaceBrush"     Color="#161B22"/>
            <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#1C2330"/>
            <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#0D1117"/>
            <SolidColorBrush x:Key="BorderBrush2"     Color="#30373F"/>
            <SolidColorBrush x:Key="BorderSubtle"     Color="#21282F"/>
            <SolidColorBrush x:Key="InkBrush"         Color="#E6EDF3"/>
            <SolidColorBrush x:Key="InkSoftBrush"     Color="#8B949E"/>
            <SolidColorBrush x:Key="InkFaintBrush"    Color="#484F58"/>
            <SolidColorBrush x:Key="AccentBrush"      Color="#F0A030"/>
            <SolidColorBrush x:Key="AccentSoftBrush"  Color="#1FF0A030"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB84D"/>
            <SolidColorBrush x:Key="NavActiveBg"      Color="#1AF0A030"/>
            <SolidColorBrush x:Key="RouteBrush"       Color="#3ECDD8"/>
            <SolidColorBrush x:Key="GoodBrush"        Color="#3FB950"/>
            <SolidColorBrush x:Key="CritBrush"        Color="#F85149"/>
            <SolidColorBrush x:Key="InputBg"          Color="#0D1117"/>

            <!-- ===== App mark ===== -->
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#161B22">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#F0A030" Thickness="5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="32,36" RadiusX="18" RadiusY="18"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F0A030">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="32,36" RadiusX="4" RadiusY="4"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#F0A030" Thickness="4" StartLineCap="Round" EndLineCap="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="32,36" EndPoint="46,22"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Speed tick marks -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#F0A030" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="14,36" EndPoint="18,36"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#F0A030" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="50,36" EndPoint="54,36"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ===== Converters ===== -->
            <conv:ConnectionStateToBrushConverter x:Key="ConnStateToBrush"/>
            <conv:ConnectionStateToTextConverter  x:Key="ConnStateToText"/>
            <conv:CameraModeToVisibilityConverter x:Key="CamModeToVisibility"/>
            <conv:BoolToStringConverter           x:Key="BoolToString"/>
            <conv:NullToVisibilityConverter       x:Key="NullToVisibility"/>
            <conv:EqualityToBoolConverter         x:Key="EqualityToBool"/>
            <conv:BoolToBrushConverter            x:Key="BoolToBrush"/>
            <conv:BoolToVisibilityConverter       x:Key="BoolToVis"/>

            <!-- ===== Base Window ===== -->
            <Style TargetType="Window">
                <Setter Property="Background"  Value="{StaticResource BgBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource InkBrush}"/>
                <Setter Property="FontFamily"  Value="Segoe UI"/>
                <Setter Property="FontSize"    Value="13"/>
            </Style>

            <!-- ===== Typography ===== -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource InkFaintBrush}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
            </Style>

            <Style x:Key="SoftText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            </Style>

            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize"   Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin"     Value="0,3,0,0"/>
            </Style>

            <Style x:Key="SectionIcon" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontSize"   Value="15"/>
                <Setter Property="Margin"     Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ===== ScrollBar (thin, dark) ===== -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width"      Value="6"/>
                <Setter Property="MinWidth"   Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#40E6EDF3" CornerRadius="3" Margin="1,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Button (Default) ===== -->
            <Style TargetType="Button">
                <Setter Property="Background"               Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground"               Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Padding"                  Value="14,7"/>
                <Setter Property="Cursor"                   Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment"   Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"   Value="#253040"/>
                                    <Setter TargetName="Root" Property="BorderBrush"  Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background"   Value="#1A2535"/>
                                    <Setter TargetName="Root" Property="BorderBrush"  Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== AccentButton ===== -->
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground"  Value="#100C00"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F0A030" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#D08A20"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== NavButton ===== -->
            <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="BorderThickness"            Value="0"/>
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding"                    Value="14,11"/>
                <Setter Property="Margin"                     Value="8,2"/>
                <Setter Property="Foreground"                 Value="{StaticResource InkSoftBrush}"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Margin="{TemplateBinding Margin}">
                                <Grid>
                                    <!-- Active left bar -->
                                    <Rectangle x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                               RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"
                                               Visibility="Collapsed" Margin="-6,4,0,4"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#12E6EDF3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1AF0A030"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== ComboBox ===== -->
            <Style TargetType="ComboBox">
                <Setter Property="Background"      Value="{StaticResource InputBg}"/>
                <Setter Property="Foreground"      Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="Padding"         Value="10,6"/>
            </Style>

            <!-- ===== ComboBoxItem — dark dropdown ===== -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background"            Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground"            Value="{StaticResource InkBrush}"/>
                <Setter Property="Padding"               Value="10,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActiveBg}"/>
                                    <Setter Property="Foreground"                 Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground"                 Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight"                 Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== TextBox ===== -->
            <Style TargetType="TextBox">
                <Setter Property="Background"     Value="{StaticResource InputBg}"/>
                <Setter Property="Foreground"     Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush"    Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"        Value="10,6"/>
                <Setter Property="CaretBrush"     Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource AccentSoftBrush}"/>
            </Style>

            <!-- ===== CardBorder ===== -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background"       Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="CornerRadius"     Value="10"/>
                <Setter Property="Padding"          Value="18"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.25"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Separator line ===== -->
            <Style x:Key="SectionDivider" TargetType="Rectangle">
                <Setter Property="Height"  Value="1"/>
                <Setter Property="Fill"    Value="{StaticResource BorderBrush2}"/>
                <Setter Property="Margin"  Value="0,10,0,14"/>
                <Setter Property="Opacity" Value="0.7"/>
            </Style>

            <!-- ===== View <-> ViewModel templates ===== -->
            <DataTemplate DataType="{x:Type vm:LiveDriveViewModel}">
                <views:LiveDriveView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RouteMapViewModel}">
                <views:RouteMapView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
