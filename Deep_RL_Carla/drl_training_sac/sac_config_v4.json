{
  "connection": {
    "host": "127.0.0.1",
    "port": 2000,
    "timeout": 20.0,
    "map_load_timeout": 300.0
  },
  "camera": {
    "width": 480,
    "height": 384,
    "obs_width": 240,
    "obs_height": 192,
    "fov": 90.0,
    "fps": 20.0,
    "camera_x": 1.5,
    "camera_y": 0.0,
    "camera_z": 2.4,
    "camera_pitch": -5.0
  },
  "env": {
    "vehicle_filter": "vehicle.lincoln.mkz2017",
    "action_repeat": 4,
    "max_episode_steps": 500,
    "off_lane_patience_steps": 10,
    "warmup_ticks": 4,
    "frame_timeout": 20.0,
    "no_rendering": false,
    "seed": 42,
    "town": [
      "Town01",
      "Town02",
      "Town03",
      "Town04"
    ],
    "town_rotate_episodes": 25
  },
  "reward": {
    "reward_mode": "normalized",
    "target_speed_mps": null,
    "w_speed": 1.0,
    "w_lane_offset": 1.0,
    "w_heading": 0.4,
    "w_steer_delta": 1.5,
    "w_long_delta": 0.1,
    "w_yaw_rate": 0.1,
    "off_lane_penalty": 2.0,
    "collision_penalty": 75.0,
    "lane_invasion_penalty": 0.5,
    "junction_mask_lane_terms": true,
    "junction_off_lane_factor": 3.0,
    "bc_action_scale": null
  },
  "sac": {
    "il_checkpoint": "../behavior_cloning/best_il_model.pth",
    "output": "./runs/sac_c",
    "warm_start": true,
    "device": "cuda",
    "gamma": 0.99,
    "actor_lr": 1e-05,
    "critic_lr": 0.0003,
    "alpha_lr": 0.0003,
    "tau": 0.005,
    "target_entropy": -4.0,
    "log_std_init_from_checkpoint": true,
    "init_alpha": 0.01,
    "bc_coef": 1.0,
    "freeze_log_std": true,
    "critic_warmup_steps": 4000,
    "log_std_init": -2.5,
    "batch_size": 32,
    "buffer_capacity": 50000,
    "learning_starts": 2000,
    "train_freq": 4,
    "gradient_steps": 1,
    "max_grad_norm": 0.5,
    "total_steps": 60000,
    "save_every_steps": 5000,
    "eval_every_steps": 10000,
    "eval_episodes": 30,
    "bc_action_scale": null,
    "reset_log_std": true,
    "explore_epsilon": 0.25
  }
}